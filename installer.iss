; Script generated by Antigravity for NoteLocal
; Compatible with Inno Setup 6+

#define MyAppName "Note Local"
#define MyAppVersion "3.0.0"
#define MyAppPublisher "Michael Tran"
#define MyAppURL "https://github.com/michaeltran8386/note-app"
#define MyAppExeName "NoteLocal.exe"

[Setup]
AppId={{5E28B025-C6DE-4849-8E99-4A0B7F832C9A}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName={localappdata}\Programs\NoteLocal
DisableProgramGroupPage=yes
; PrivilegesRequired=lowest cho phep cai dat vao AppData/Local/Programs ma khong can quyen Admin (UAC) giong VS Code/Sonora
PrivilegesRequired=lowest
OutputDir=dist
OutputBaseFilename=NoteLocal-Setup-x64
SetupIconFile=resources\app.ico
Compression=lzma2/ultra64
SolidCompression=yes
WizardStyle=modern
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
UninstallDisplayIcon={app}\resources\app.ico

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
Source: "build\bin\NoteLocal.exe"; DestDir: "{app}"; Flags: ignoreversion
Source: "build\bin\WebView2Loader.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: "src\ui\assets\*"; DestDir: "{app}\src\ui\assets"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "resources\app.ico"; DestDir: "{app}\resources"; Flags: ignoreversion

[Icons]
Name: "{autoprograms}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; IconFilename: "{app}\resources\app.ico"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon; IconFilename: "{app}\resources\app.ico"

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent

